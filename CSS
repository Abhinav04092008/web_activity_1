@import url('https://fonts.googleapis.com/css2?family=Bree+Serif&family=Caveat:wght@400;700&family=Lobster&family=Monoton&family=Open+Sans:ital,wght@0,400;0,700;1,400;1,700&family=Playfair+Display+SC:ital,wght@0,400;0,700;1,700&family=Playfair+Display:ital,wght@0,400;0,700;1,700&family=Roboto:ital,wght@0,400;0,700;1,400;1,700&family=Source+Sans+Pro:ital,wght@0,400;0,700;1,700&family=Work+Sans:ital,wght@0,400;0,700;1,700&display=swap');

/* GENERAL STYLING */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: #fff8ed;
    color: #252525;
}

h1,
h2,
h3 {
    font-family: 'Playfair Display', serif;
}

a {
    text-decoration: none;
}

.section {
    padding: 90px 8%;
}

.tagline {
    color: #b68b3c;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 3px;
    margin-bottom: 15px;
}

/* NAVBAR */

header {
    background: #4b101c;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 8%;
}

.logo {
    color: white;
    font-size: 27px;
}

.logo span,
footer span {
    color: #d4a853;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 25px;
}

.nav-links a {
    color: white;
    font-size: 14px;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #d4a853;
}

.nav-btn {
    background: #d4a853;
    color: #4b101c;
    padding: 12px 20px;
    border-radius: 5px;
    font-weight: 600;
}

/* HERO SECTION */

.hero {
    min-height: 620px;
    background:
        linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)),
        url("https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1600");
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    padding: 80px 10%;
    color: white;
}

.hero-content {
    max-width: 650px;
}

.hero h1 {
    font-size: 58px;
    line-height: 1.2;
    margin-bottom: 25px;
}

.hero h1 span {
    color: #d4a853;
}

.hero-content>p:not(.tagline) {
    line-height: 1.8;
    color: #eee;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
}

.primary-btn,
.secondary-btn {
    padding: 14px 25px;
    border-radius: 5px;
    font-weight: 600;
}

.primary-btn {
    background: #d4a853;
    color: #4b101c;
}

.secondary-btn {
    border: 1px solid white;
    color: white;
}

/* ABOUT SECTION */

.about {
    display: flex;
    align-items: center;
    gap: 60px;
}

.about-image,
.about-content {
    flex: 1;
}

.about-image img {
    width: 100%;
    border-radius: 12px;
}

.about-content h2,
.section-heading h2 {
    font-size: 38px;
    margin-bottom: 20px;
}

.about-content>p:not(.tagline) {
    color: #666;
    line-height: 1.9;
}

.features {
    margin-top: 25px;
}

.features div {
    margin-bottom: 20px;
}

.features h3 {
    color: #4b101c;
    margin-bottom: 5px;
}

.features p {
    color: #777;
    font-size: 14px;
}

/* SECTION HEADINGS */

.section-heading {
    text-align: center;
    margin-bottom: 45px;
}

.section-heading>p:last-child {
    color: #777;
}

/* MENU SECTION */

.menu {
    background: #f5ebdc;
}

.menu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}

.food-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.07);
    transition: 0.3s;
}

.food-card:hover {
    transform: translateY(-8px);
}

.food-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

.food-info {
    padding: 22px;
}

.food-info h3 {
    color: #4b101c;
    font-size: 21px;
    margin-bottom: 10px;
}

.food-info p {
    color: #777;
    font-size: 14px;
    margin-bottom: 15px;
}

.food-info h4 {
    color: #b68b3c;
    font-size: 20px;
}

/* OFFERS SECTION */

.offer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.offer-card {
    background: #4b101c;
    color: white;
    padding: 40px 25px;
    border-radius: 12px;
    text-align: center;
    transition: 0.3s;
}

.offer-card:hover {
    transform: translateY(-8px);
}

.offer-card h3 {
    font-size: 24px;
    margin-bottom: 20px;
}

.offer-card h2 {
    color: #d4a853;
    font-size: 35px;
    margin-bottom: 15px;
}

.offer-card p {
    margin-bottom: 20px;
    color: #eee;
}

.offer-card span {
    color: #d4a853;
    font-size: 13px;
}

/* WHY CHOOSE US */

.why-us {
    background: #f5ebdc;
}

.why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.why-card {
    background: white;
    padding: 30px 20px;
    text-align: center;
    border-radius: 10px;
}

.why-card h3 {
    color: #4b101c;
    margin-bottom: 15px;
}

.why-card p {
    color: #777;
    font-size: 14px;
    line-height: 1.7;
}

/* REVIEWS */

.review-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.review-card {
    background: white;
    padding: 35px;
    border-radius: 10px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
}

.stars {
    color: #d4a853;
    font-size: 22px;
    margin-bottom: 20px;
}

.review-card p {
    color: #666;
    line-height: 1.8;
    margin-bottom: 20px;
}

.review-card h3 {
    color: #4b101c;
}

.review-card span {
    color: #999;
    font-size: 13px;
}

/* GALLERY */

.gallery {
    background: #f5ebdc;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.gallery-grid img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    border-radius: 10px;
    transition: 0.3s;
}

.gallery-grid img:hover {
    transform: scale(1.04);
}

/* RESERVATION */

.reservation-form {
    max-width: 750px;
    margin: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.reservation-form input,
.reservation-form select,
.reservation-form textarea,
.contact-form input,
.contact-form textarea {
    width: 100%;
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 5px;
    font-family: inherit;
    outline: none;
}

.reservation-form textarea {
    grid-column: span 2;
    height: 100px;
}

.reservation-form button,
.contact-form button {
    background: #4b101c;
    color: white;
    padding: 15px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 15px;
    font-family: inherit;
}

.reservation-form button:hover,
.contact-form button:hover {
    background: #8b2638;
}

/* CONTACT */

.contact {
    background: #f5ebdc;
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
}

.contact-info h3 {
    color: #4b101c;
    font-size: 25px;
    margin-bottom: 25px;
}

.contact-info p {
    color: #666;
    margin-bottom: 20px;
    line-height: 1.7;
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.contact-form textarea {
    height: 120px;
}

/* FOOTER */

footer {
    background: #4b101c;
    color: white;
    text-align: center;
    padding: 50px 20px 20px;
}

footer h2 {
    font-size: 30px;
    margin-bottom: 10px;
}

footer p {
    color: #ddd;
    margin-bottom: 20px;
}

.footer-links {
    display: flex;
    justify-content: center;
    gap: 25px;
    margin: 25px 0;
}

.footer-links a {
    color: white;
}

.footer-links a:hover {
    color: #d4a853;
}

.copyright {
    border-top: 1px solid #70404a;
    padding-top: 20px;
    font-size: 13px;
    margin-top: 30px;
    margin-bottom: 0;
}

/* RESPONSIVE DESIGN */

@media (max-width: 900px) {

    .navbar {
        flex-wrap: wrap;
        gap: 20px;
    }

    .nav-links {
        gap: 15px;
        flex-wrap: wrap;
    }

    .menu-grid,
    .offer-grid,
    .review-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .why-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero h1 {
        font-size: 45px;
    }
}

@media (max-width: 600px) {

    .section {
        padding: 60px 6%;
    }

    .navbar {
        flex-direction: column;
    }

    .nav-links {
        justify-content: center;
        gap: 12px;
    }

    .nav-links a {
        font-size: 12px;
    }

    .nav-btn {
        display: none;
    }

    .hero {
        min-height: 550px;
        padding: 50px 7%;
    }

    .hero h1 {
        font-size: 37px;
    }

    .hero-buttons {
        flex-wrap: wrap;
    }

    .about {
        flex-direction: column;
    }

    .about-content h2,
    .section-heading h2 {
        font-size: 30px;
    }

    .menu-grid,
    .offer-grid,
    .review-grid,
    .why-grid,
    .gallery-grid,
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .reservation-form {
        grid-template-columns: 1fr;
    }

    .reservation-form textarea {
        grid-column: span 1;
    }

    .footer-links {
        flex-wrap: wrap;
    }
}
