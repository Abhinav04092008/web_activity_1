<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Royal Feast | Restaurant</title>
    <link rel="stylesheet" href="style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar">
            <h2 class="logo">The Royal <span>Feast.</span></h2>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#menu">Menu</a></li>
                <li><a href="#offers">Offers</a></li>
                <li><a href="#reviews">Reviews</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>

            <a href="#reservation" class="nav-btn">Book a Table</a>
        </nav>
    </header>

    <!-- HERO SECTION -->
    <section class="hero" id="home">
        <div class="hero-content">
            <p class="tagline">WELCOME TO THE ROYAL FEAST</p>

            <h1>Experience the Art of <span>Fine Dining</span></h1>

            <p>
                Delicious food, unforgettable moments and exceptional
                hospitality. Discover your new favourite dining destination.
            </p>

            <div class="hero-buttons">
                <a href="#menu" class="primary-btn">Explore Menu</a>
                <a href="#reservation" class="secondary-btn">Book a Table</a>
            </div>
        </div>
    </section>

    <!-- ABOUT SECTION -->
    <section class="about section" id="about">
        <div class="about-image">
            <img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=900" alt="Restaurant dining">
        </div>

        <div class="about-content">
            <p class="tagline">OUR STORY</p>
            <h2>A Story of Passion and Flavour</h2>

            <p>
                At The Royal Feast, we believe every meal should be
                a memorable experience. Our chefs combine traditional
                recipes with modern creativity to bring you delicious
                food made with quality ingredients and passion.
            </p>

            <div class="features">
                <div>
                    <h3>✦ Fresh Ingredients</h3>
                    <p>Fresh and quality ingredients every day.</p>
                </div>

                <div>
                    <h3>✦ Expert Chefs</h3>
                    <p>Delicious food prepared with passion.</p>
                </div>

                <div>
                    <h3>✦ Best Hospitality</h3>
                    <p>Making every visit special.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- MENU SECTION -->
    <section class="menu section" id="menu">
        <div class="section-heading">
            <p class="tagline">OUR SPECIALITIES</p>
            <h2>Explore Our Delicious Menu</h2>
            <p>Discover amazing flavours prepared just for you.</p>
        </div>

        <div class="menu-grid">

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1567188040759-fb8a883dc6d8?w=600" alt="Paneer Tikka">
                <div class="food-info">
                    <h3>Paneer Tikka</h3>
                    <p>Delicious grilled paneer with spices.</p>
                    <h4>₹249</h4>
                </div>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1563379091339-03246963d96c?w=600" alt="Biryani">
                <div class="food-info">
                    <h3>Chicken Biryani</h3>
                    <p>Authentic aromatic biryani.</p>
                    <h4>₹299</h4>
                </div>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1546833999-b9f581a1996d?w=600" alt="Indian Curry">
                <div class="food-info">
                    <h3>Paneer Butter Masala</h3>
                    <p>Rich and creamy Indian curry.</p>
                    <h4>₹249</h4>
                </div>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1601050690597-df0568f70950?w=600" alt="Samosa">
                <div class="food-info">
                    <h3>Veg Starters</h3>
                    <p>Crispy and delicious starters.</p>
                    <h4>₹199</h4>
                </div>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1551024506-0bccd828d307?w=600" alt="Dessert">
                <div class="food-info">
                    <h3>Chocolate Dessert</h3>
                    <p>Sweet treats for your happiness.</p>
                    <h4>₹149</h4>
                </div>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1544145945-f90425340c7e?w=600" alt="Fresh drink">
                <div class="food-info">
                    <h3>Fresh Lime Soda</h3>
                    <p>Refreshing drink for everyone.</p>
                    <h4>₹79</h4>
                </div>
            </div>

        </div>
    </section>

    <!-- OFFERS SECTION -->
    <section class="offers section" id="offers">
        <div class="section-heading">
            <p class="tagline">SPECIAL DEALS</p>
            <h2>Offers You Can't Miss</h2>
        </div>

        <div class="offer-grid">

            <div class="offer-card">
                <h3>Family Feast</h3>
                <h2>20% OFF</h2>
                <p>Enjoy delicious meals with your family.</p>
                <span>Code: FAMILY20</span>
            </div>

            <div class="offer-card">
                <h3>Weekend Special</h3>
                <h2>1 FREE</h2>
                <p>Buy 2 Biryanis and get 1 dessert free.</p>
                <span>Weekend Offer</span>
            </div>

            <div class="offer-card">
                <h3>Student Special</h3>
                <h2>15% OFF</h2>
                <p>Special discount for students.</p>
                <span>Valid Student ID Required</span>
            </div>

        </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="why-us section">
        <div class="section-heading">
            <p class="tagline">WHY CHOOSE US</p>
            <h2>More Than Just Food</h2>
        </div>

        <div class="why-grid">
            <div class="why-card">
                <h3>🥗 Fresh Ingredients</h3>
                <p>We use quality ingredients for every dish.</p>
            </div>

            <div class="why-card">
                <h3>👨‍🍳 Expert Chefs</h3>
                <p>Experienced chefs create amazing flavours.</p>
            </div>

            <div class="why-card">
                <h3>🍽️ Comfortable Dining</h3>
                <p>Enjoy your meals in a relaxing atmosphere.</p>
            </div>

            <div class="why-card">
                <h3>⭐ Best Service</h3>
                <p>Customer satisfaction is our priority.</p>
            </div>
        </div>
    </section>

    <!-- REVIEWS SECTION -->
    <section class="reviews section" id="reviews">
        <div class="section-heading">
            <p class="tagline">CUSTOMER EXPERIENCES</p>
            <h2>What Our Customers Say</h2>
        </div>

        <div class="review-grid">

            <div class="review-card">
                <div class="stars">★★★★★</div>
                <p>"Excellent food and amazing atmosphere. The service was outstanding!"</p>
                <h3>Rahul</h3>
                <span>Happy Customer</span>
            </div>

            <div class="review-card">
                <div class="stars">★★★★★</div>
                <p>"One of the best dining experiences. The biryani was absolutely delicious."</p>
                <h3>Priya</h3>
                <span>Happy Customer</span>
            </div>

            <div class="review-card">
                <div class="stars">★★★★★</div>
                <p>"Beautiful ambience, friendly staff and delicious food. Definitely visiting again!"</p>
                <h3>Arjun</h3>
                <span>Happy Customer</span>
            </div>

        </div>
    </section>

    <!-- GALLERY SECTION -->
    <section class="gallery section">
        <div class="section-heading">
            <p class="tagline">OUR GALLERY</p>
            <h2>A Glimpse of Our World</h2>
        </div>

        <div class="gallery-grid">
            <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=700" alt="Restaurant interior">
            <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=700" alt="Delicious pizza">
            <img src="https://images.unsplash.com/photo-1547592180-85f173990554?w=700" alt="Fresh food">
            <img src="https://images.unsplash.com/photo-1559339352-11d035aa65de?w=700" alt="Restaurant dining">
        </div>
    </section>

    <!-- RESERVATION SECTION -->
    <section class="reservation section" id="reservation">
        <div class="section-heading">
            <p class="tagline">BOOK YOUR EXPERIENCE</p>
            <h2>Reserve Your Table</h2>
            <p>Make your dining experience special.</p>
        </div>

        <form class="reservation-form">
            <input type="text" placeholder="Full Name" required>
            <input type="email" placeholder="Email Address" required>
            <input type="tel" placeholder="Phone Number" required>
            <input type="date" required>
            <input type="time" required>

            <select required>
                <option value="">Number of Guests</option>
                <option>1 Guest</option>
                <option>2 Guests</option>
                <option>3 Guests</option>
                <option>4 Guests</option>
                <option>5+ Guests</option>
            </select>

            <textarea placeholder="Special Requests"></textarea>

            <button type="submit">Book Your Table</button>
        </form>
    </section>

    <!-- CONTACT SECTION -->
    <section class="contact section" id="contact">
        <div class="section-heading">
            <p class="tagline">GET IN TOUCH</p>
            <h2>Visit The Royal Feast</h2>
        </div>

        <div class="contact-grid">
            <div class="contact-info">
                <h3>Contact Information</h3>
                <p>📍 Main Road, Vijayawada, Andhra Pradesh, India</p>
                <p>📞 +91 98765 43210</p>
                <p>✉ hello@theroyalfeast.example</p>
                <p>🕒 11:00 AM – 11:00 PM</p>
            </div>

            <div class="contact-info">
                <h3>Send Us a Message</h3>
                <form class="contact-form">
                    <input type="text" placeholder="Your Name" required>
                    <input type="email" placeholder="Your Email" required>
                    <textarea placeholder="Your Message" required></textarea>
                    <button type="submit">Send Message</button>
                </form>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <h2>The Royal <span>Feast.</span></h2>
        <p>A Taste Beyond Expectations.</p>

        <div class="footer-links">
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#menu">Menu</a>
            <a href="#contact">Contact</a>
        </div>

        <p class="copyright">
            © 2026 The Royal Feast. All Rights Reserved.
        </p>
    </footer>

</body>

</html>
